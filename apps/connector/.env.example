# URL pubblico HTTPS del server oppure http://localhost:3000 per prove locali
WORKSPACE_URL=http://localhost:3000
DEVICE_NAME=PC-WINDOWS-01
# Copia qui il codice mostrato sul sito solo per la prima associazione, poi rimuovilo.
PAIR_CODE=
# Cartella nella quale OpenCode esegue le operazioni.
OPENCODE_WORKDIR=C:\AI-Workspace
OPENCODE_PORT=4096
# Password solo locale. Sceglila lunga e casuale e non pubblicarla.
OPENCODE_SERVER_PASSWORD=replace_with_unique_long_password
# true per avviare opencode serve automaticamente (altrimenti avvialo manualmente)
AUTO_START_OPENCODE=true
